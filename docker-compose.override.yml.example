# ─────────────────────────────────────────────────────────────────────────────
# docker-compose.override.yml.example
#
# Copy this file to docker-compose.override.yml to customise the deployment.
# Place it in the site directory (next to app/); the run script merges it
# automatically. When running docker compose by hand from this directory,
# Docker Compose merges it on its own.
# ─────────────────────────────────────────────────────────────────────────────

services:

  # ── Example: expose the site via Traefik (reverse proxy) ──────────────────
  # Replace "mysite.localhost" with your desired hostname.
  # Ensure Traefik is running and connected to the "traefik" external network.

  wordpress:
    # Remove the direct port binding when Traefik is in front
    # !reset is required: a plain empty list merges with (and keeps) the
    # base file's port binding instead of removing it.
    ports: !reset []
    networks:
      - default
      - traefik
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.wordpress.rule=Host(`mysite.localhost`)"
      - "traefik.http.routers.wordpress.entrypoints=web"
      - "traefik.http.services.wordpress.loadbalancer.server.port=80"

  # ── Example: override environment variables ────────────────────────────────
  # wordpress:
  #   environment:
  #     WORDPRESS_DEBUG: "1"

networks:
  traefik:
    external: true
