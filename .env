# ─────────────────────────────────────────────────────────────────────────────
# LocalWP Docker Compose – configuration
# Adjust these values before running `docker compose up --build`
# ─────────────────────────────────────────────────────────────────────────────

# ── Web server ──────────────────────────────────────────────────────────────
# Set to "apache" (default) or "nginx" (uses PHP-FPM + nginx).
# Changing this value requires rebuilding the image: docker compose up --build
COMPOSE_PROFILES=apache

# ── PHP version ─────────────────────────────────────────────────────────────
# Examples: 8.3  8.2  8.1  8.0  7.4
# Changing this value requires rebuilding the image: docker compose up --build
PHP_VERSION=8.2

# ── Local URL ───────────────────────────────────────────────────────────────
# The hostname (and optional port) where the site will be reachable.
# For plain localhost access keep this as-is.
# Use a custom hostname if you have a local DNS / hosts entry for it.
LOCAL_URL=http://localhost:8080

# ── WordPress database credentials ──────────────────────────────────────────
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword

# ── Host port mappings ──────────────────────────────────────────────────────
HTTP_PORT=8080
